{
  "name": "pixelforge-ai",
  "private": true,
  "version": "1.13.2",
  "type": "module",
  "scripts": {
    "dev": "vite --mode pixelart --open",
    "dev:pixelart": "vite --mode pixelart --open",
    "dev:studio": "vite --mode pixelart --open",
    "dev:apk": "vite --mode apk --host --open",
    "dev:game": "vite --mode apk --host --open",
    "build": "vue-tsc --noEmit && vite build && node scripts/generate-update-manifest.mjs",
    "build:bundle": "node scripts/generate-update-manifest.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:architecture": "depcruise src --config .dependency-cruiser.cjs && vitest run src/shared/architecture.spec.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test:architecture && pnpm test:coverage && pnpm build",
    "android:dev": "cap run android -l --external",
    "android:sync": "pnpm build && cap sync android",
    "android:build": "pnpm android:sync && cd android && ./gradlew assembleDebug",
    "prepare": "husky"
  },
  "dependencies": {
    "@babylonjs/core": "^9.35.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.0.9",
    "@types/adm-zip": "^0.6.0",
    "@types/node": "^22.13.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.5.1",
    "adm-zip": "^0.6.1",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "knip": "^6.44.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.2.0",
    "vitest": "^4.1.12",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^2.2.8"
  }
}
